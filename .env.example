# MithaiBoxes E-Commerce Platform
# Environment Variables Template
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local or any file containing real secrets.

# ============================================================
# APPLICATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# DATABASE
# ============================================================
# MongoDB connection string (Replica Set REQUIRED for transactions)
# Local:    mongodb://localhost:27017/mithaiboxes?replicaSet=rs0
# Atlas:    mongodb+srv://user:password@cluster.mongodb.net/mithaiboxes
MONGODB_URI=mongodb://localhost:27017/mithaiboxes

# ============================================================
# DATABASE - TURSO (Optional: SQLite-based, per-user databases)
# If using Turso, these are required. Otherwise, MongoDB is used.
# Turso provides encrypted, replicated SQLite databases per user.
# Sign up at https://turso.tech
#
# Spin up a database for every user
import { createClient } from '@tursodatabase/api';

const turso = createClient({
  org: process.env.TURSO_ORG,
  token: process.env.TURSO_PLATFORM_TOKEN,
});

const db = await turso.databases.create({
  name: `user-${userId}`,
  group: 'production',
});

# That's it. Encrypted. Replicated. Yours.

# ============================================================
# AUTHENTICATION & SESSIONS
# ============================================================
# Minimum 32 characters, cryptographically random
SESSION_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET_DO_NOT_USE_THIS

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_VERIFY_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Admin session duration (seconds)
ADMIN_SESSION_TTL_SECONDS=28800

# Customer session duration (seconds) 
CUSTOMER_SESSION_TTL_SECONDS=2592000

# ============================================================
# EMAIL PROVIDER
# ============================================================
# Choose: resend | smtp
EMAIL_PROVIDER=resend

# From address (must be verified with your provider)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=MithaiBoxes

# --- Resend (recommended) ---
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# --- SMTP (alternative) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# ============================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================
# Use TEST keys during development. Never use live keys in dev.
# Test keys: https://dashboard.razorpay.com/app/keys (Test Mode)

# Server-side secret (NEVER expose in client bundles)
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_SECRET

# Client-side publishable key (safe to expose to browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID

# Webhook secret from Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ============================================================
# OBJECT STORAGE (Product Images & Uploads)
# ============================================================
# Choose: s3 | r2 | local
# 'local' stores files in /public/uploads - NOT for production
STORAGE_PROVIDER=local

# Public base URL for stored images
STORAGE_PUBLIC_URL=http://localhost:3000/uploads

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mithaiboxes-products

# --- Cloudflare R2 (alternative to S3) ---
CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=mithaiboxes-products

# ============================================================
# ERROR MONITORING (Sentry)
# ============================================================
SENTRY_DSN=https://REPLACE@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=REPLACE_WITH_SENTRY_AUTH_TOKEN

# ============================================================
# ADMIN BOOTSTRAP (one-time use)
# ============================================================
# Used by: pnpm run bootstrap:admin
# Remove or leave blank after initial admin is created
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ============================================================
# RATE LIMITING
# ============================================================
# Auth endpoints: max requests per window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# API endpoints general
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# ============================================================
# FEATURE FLAGS
# ============================================================
# Set to 'true' to enable
FEATURE_GUEST_CHECKOUT=true
FEATURE_WISHLIST=true
FEATURE_REVIEWS=false
FEATURE_PHONE_OTP=false
FEATURE_NEWSLETTER=true

# ============================================================
# SHIPPING (Configurable — no hardcoded rates)
# ============================================================
# All shipping configuration managed via admin dashboard settings
# These env vars only affect fallback behavior
SHIPPING_FREE_THRESHOLD_INR=0
SHIPPING_DEFAULT_ESTIMATE_DAYS=2

# ============================================================
# DEVELOPMENT / TESTING ONLY
# ============================================================
# NEVER set these in production
MOCK_PAYMENT=false
MOCK_EMAIL=false
SEED_DATABASE=false